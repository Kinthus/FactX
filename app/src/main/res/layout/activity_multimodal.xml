<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFCFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multimodal Analysis"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#173B91"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"/>

        <!-- Description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyze news using both text and image."
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"/>

        <!-- News Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="News Title"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter News Title (Optional)"
            android:padding="15dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"/>

        <!-- News Content -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="News Content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/etNews"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:hint="Enter News Content (Optional)"
            android:gravity="top|start"
            android:padding="15dp"
            android:inputType="textMultiLine"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"/>

        <!-- Image Preview -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="News Image"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/logo"
            android:scaleType="centerInside"
            android:background="#E8E8E8"
            android:contentDescription="Selected news image"/>

        <!-- Select Image -->

        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:text="Select Image"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#173B91"
            android:textColor="#FFFFFF"/>

        <!-- Analyze -->

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Analyze News"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#173B91"
            android:textColor="#FFFFFF"/>

        <!-- Clear -->

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:text="Clear"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#BDBDBD"
            android:textColor="#000000"/>

    </LinearLayout>

</ScrollView>